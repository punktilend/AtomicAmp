<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberately sparse. A widget is read at a glance from a home screen, so it carries the cover,
  what is playing, and the three controls anyone actually reaches for. Everything else is a tap
  away in the app.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="10dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:background="@color/atomic_surface" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/atomic_on_surface"
            android:textSize="15sp"
            android:textStyle="bold"
            android:text="@string/widget_nothing_playing" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/atomic_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_prev"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackground"
        android:src="@android:drawable/ic_media_previous"
        android:contentDescription="@string/widget_previous" />

    <ImageButton
        android:id="@+id/widget_play_pause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackground"
        android:src="@android:drawable/ic_media_play"
        android:contentDescription="@string/widget_play_pause" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackground"
        android:src="@android:drawable/ic_media_next"
        android:contentDescription="@string/widget_next" />
</LinearLayout>
