<!--
  An amplifier knob crossed with an orbit: the two halves of the name, in the amber the app
  itself uses. Everything sits inside the inner 66dp safe zone, since a launcher may mask the
  outer ring to any shape it likes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Orbit, tilted so it reads as a path around the knob rather than a flat underline. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-26">
        <path
            android:fillColor="#00000000"
            android:pathData="M27,54 a27,12 0 1,0 54,0 a27,12 0 1,0 -54,0"
            android:strokeColor="#FFB35C"
            android:strokeWidth="3.5"
            android:strokeAlpha="0.55" />
        <path
            android:fillColor="#FFB35C"
            android:pathData="M81,54 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0" />
    </group>

    <!-- Knob body, drawn over the orbit so the orbit reads as passing behind it. -->
    <path
        android:fillColor="#0D0F11"
        android:pathData="M54,54 m-21,0 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0" />
    <path
        android:fillColor="#00000000"
        android:pathData="M34,54 a20,20 0 1,0 40,0 a20,20 0 1,0 -40,0"
        android:strokeColor="#FFB35C"
        android:strokeWidth="6.5" />

    <!-- Pointer at twelve o'clock: the one detail that says "level" rather than "planet". -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,40 L54,54"
        android:strokeColor="#FFB35C"
        android:strokeLineCap="round"
        android:strokeWidth="6.5" />
</vector>
