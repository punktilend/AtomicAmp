<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The library is built on SAF grants, which need no permission. This is here for the
      diagnostics probe, and for the direct-filesystem fallback that becomes necessary if the
      head unit's firmware turns out to ship no document picker at all.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!--
      13 split the storage permission by media type. Without this declaration the runtime request
      MainActivity makes on 13+ is auto-denied with no dialog shown, which fails silently.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!--
      Tag editing rewrites the file in place, which needs write access to shared storage. Only
      meaningful up to 29, where requestLegacyExternalStorage still applies. From 30 that path is
      unavailable at any permission level, which is why the editor says so up front rather than
      failing at save time.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
      Streaming a personal Backblaze B2 library. This is the one permission that changes what the
      app can say about itself: PRIVACY.md and the Play listing both claimed the app had no way to
      reach the network at all, and that is no longer true. Both need updating before release.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Package visibility filtering (API 30+) would otherwise hide picker activities from
      queryIntentActivities and make "no handler" indistinguishable from "not allowed to look".
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AtomicAmp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AtomicAmp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Album art has to be readable by other processes: the system media notification, the lock
          screen, and a head unit's own now-playing panel all load it themselves. Publishing a
          file:// URI into app-private storage leaves them with nothing to open.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.albumart"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>


        <receiver
            android:name=".widget.NowPlayingWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="atomicamp.STATE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing_info" />
        </receiver>

    </application>

</manifest>
